# .editorconfig
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.py]
indent_size = 4
max_line_length = 100

[*.{yaml,yml}]
indent_size = 2

[*.json]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = 0

[*.{sh,bash}]
indent_size = 4
end_of_line = lf

[*.{ps1,psm1}]
indent_size = 4
end_of_line = crlf

[*.toml]
indent_size = 2

[*.{cfg,conf,ini}]
indent_size = 4
